<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cansu Özcan Yakın - IBAN</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #fff9df, #f5f7fa);
  font-family: Arial, sans-serif;
  color: #17213c;
}

.card {
  width: calc(100% - 32px);
  max-width: 430px;
  background: white;
  padding: 30px 22px;
  border-radius: 22px;
  box-shadow: 0 10px 35px rgba(0,0,0,0.10);
  text-align: center;
  border-top: 6px solid #f5c400;
}

/* VakıfBank Logo Alanı */
.vakifbank-logo {
  width: 92px;
  height: 82px;
  margin: 0 auto 18px;
  background: #f5c400;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #17213c;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -0.5px;
  box-shadow: 0 5px 15px rgba(245,196,0,0.25);
}

.bank-name {
  color: #17213c;
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 8px;
}

h1 {
  margin: 0 0 8px;
  font-size: 26px;
  color: #17213c;
}

.subtitle {
  color: #6b7280;
  margin-bottom: 25px;
}

.iban {
  background: #fffbea;
  border: 1px solid #f5d96b;
  padding: 18px 12px;
  border-radius: 14px;
  font-size: 17px;
  font-weight: bold;
  letter-spacing: 0.8px;
  word-break: break-all;
  margin-bottom: 18px;
  color: #17213c;
}

button {
  width: 100%;
  padding: 16px;
  border: 0;
  border-radius: 13px;
  background: #f5c400;
  color: #17213c;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.2s ease;
}

button:hover {
  background: #e4b600;
}

button:active {
  transform: scale(0.98);
}

#message {
  margin-top: 15px;
  color: #16a34a;
  font-weight: bold;
  min-height: 20px;
}
</style>
</head>

<body>

<div class="card">

  <div class="vakifbank-logo">
    VakıfBank
  </div>

  <div class="bank-name">
    VakıfBank
  </div>

  <h1>Cansu Özcan Yakın</h1>

  <div class="subtitle">
    Banka Hesap Bilgisi
  </div>

  <div class="iban" id="iban">
    TR960001500158007308737142
  </div>

  <button onclick="copyIBAN()">
    IBAN'ı Kopyala
  </button>

  <div id="message"></div>

</div>

<script>
function copyIBAN() {

  const iban = "TR960001500158007308737142";

  navigator.clipboard.writeText(iban)
    .then(function() {

      document.getElementById("message").textContent =
        "IBAN panoya kopyalandı ✓";

    })
    .catch(function() {

      const textArea = document.createElement("textarea");

      textArea.value = iban;

      document.body.appendChild(textArea);

      textArea.select();

      document.execCommand("copy");

      textArea.remove();

      document.getElementById("message").textContent =
        "IBAN panoya kopyalandı ✓";

    });
}
</script>

</body>
</html>
